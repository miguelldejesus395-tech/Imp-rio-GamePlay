<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — Império GamePlay</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, sans-serif; }
    body {
      min-height: 100vh;
      background: radial-gradient(circle at top, #2a1f4d 0, #0a0814 50%);
      color: #e6f0ff;
    }
    header {
      background: rgba(20, 10, 40, 0.85);
      padding: 15px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(139, 92, 246, 0.3);
    }
    .logo { font-size: 22px; font-weight: bold; color: #a78bfa; }
    .btn {
      padding: 8px 16px; border-radius: 6px; border: none;
      background: #7c3aed; color: white; cursor: pointer;
    }
    .btn-sair { background: #dc2626; }
    .container { max-width: 1200px; margin: 30px auto; padding: 0 20px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin: 25px 0; }
    .card {
      background: rgba(50, 30, 80, 0.3);
      border: 1px solid rgba(139, 92, 246, 0.25);
      border-radius: 12px; padding: 20px;
    }
    .card h3 { margin-bottom: 10px; color: #c4b5fd; }
    .valor { font-size: 28px; font-weight: bold; margin-top: 8px; }
    .menu-lateral {
      display: flex; flex-direction: column; gap: 8px; margin-top: 20px;
    }
    .menu-lateral a {
      color: #cbd5e1; text-decoration: none; padding: 12px 15px;
      border-radius: 8px; transition: 0.2s;
    }
    .menu-lateral a:hover, .menu-lateral a.ativo {
      background: rgba(139, 92, 246, 0.2); color: white;
    }
    .conteudo { display: flex; gap: 25px; }
    .col-esq { width: 200px; }
    .col-dir { flex: 1; }
    h2 { margin-bottom: 20px; border-bottom: 1px solid rgba(139, 92, 246, 0.25); padding-bottom: 10px; }
    table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    th, td { padding: 12px; text-align: left; border-bottom: 1px solid rgba(139, 92, 246, 0.15); }
    th { color: #c4b5fd; }
    input, button {
      padding: 10px; border-radius: 6px; border: none; margin: 5px;
    }
    .btn-sucesso { background: #16a34a; }
  </style>
</head>
<body>
  <header>
    <div class="logo">👑 Império GamePlay — ADMIN</div>
    <button class="btn btn-sair" onclick="sair()">Sair</button>
  </header>

  <div class="container conteudo">
    <div class="col-esq">
      <div class="menu-lateral">
        <a href="#" class="ativo">📊 Painel Geral</a>
        <a href="#">👥 Usuários</a>
        <a href="#">⏱️ Gerenciar Minutos</a>
        <a href="#">🖥️ Servidores</a>
        <a href="#">📦 Planos</a>
        <a href="#">📜 Pedidos</a>
        <a href="#">🔔 Notificações</a>
      </div>
    </div>

    <div class="col-dir">
      <h2>Painel de Controle — Administrador</h2>
      
      <div class="grid">
        <div class="card">
          <h3>👥 Total de Usuários</h3>
          <p class="valor" id="total-usuarios">0</p>
        </div>
        <div class="card">
          <h3>🖥️ Servidores Ativos</h3>
          <p class="valor" id="servidores-ativos">0</p>
        </div>
        <div class="card">
          <h3>📋 Pedidos do Dia</h3>
          <p class="valor" id="pedidos-dia">0</p>
        </div>
        <div class="card">
          <h3>💰 Total em Vendas</h3>
          <p class="valor">R$ 0,00</p>
        </div>
      </div>

      <div class="card" style="margin-top: 30px;">
        <h3>⏱️ Adicionar Minutos ao Usuário</h3>
        <input type="text" placeholder="Usuário" id="usuario-alvo">
        <input type="number" placeholder="Minutos" id="qtd-minutos">
        <button class="btn btn-sucesso">Adicionar</button>
      </div>

      <div class="card" style="margin-top: 30px;">
        <h3>👥 Usuários Cadastrados</h3>
        <table>
          <thead>
            <tr>
              <th>Usuário</th>
              <th>Minutos</th>
              <th>Plano</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="lista-usuarios">
            <tr><td colspan="4" style="color:#94a3b8;">Nenhum usuário cadastrado</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('igc_token');
    const role = localStorage.getItem('igc_role');
    if (!token || role !== 'admin') window.location.href = 'index.html';

    function sair() {
      localStorage.removeItem('igc_token');
      localStorage.removeItem('igc_role');
      window.location.href = 'index.html';
    }
  </script>
</body>
</html>

